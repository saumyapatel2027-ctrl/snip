# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by the Dodo webhook to update designer plans. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Dodo Payments (Dashboard → Developer) ----
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
# test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product IDs of the two subscription products you create in Dodo (Products → View details)
DODO_PRODUCT_PREMIUM=
DODO_PRODUCT_PRIORITY=
